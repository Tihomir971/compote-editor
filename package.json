{
	"name": "compote-editor",
	"version": "0.5.8",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev --open",
		"build": "bun run sync:pagedjs-polyfill && vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "bun run sync:pagedjs-polyfill && svelte-kit sync || echo ''",
		"prepack": "bun run sync:pagedjs-polyfill && svelte-kit sync && svelte-package && publint",
		"sync:pagedjs-polyfill": "node scripts/sync-pagedjs-polyfill.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"patch": "npm version patch && npm publish",
		"minor": "npm version minor && npm publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"compote-ui": ">=0.68.2",
		"svelte": "^5.55.9"
	},
	"dependencies": {
		"@tiptap/core": "^3.29.0",
		"@tiptap/extension-subscript": "^3.29.0",
		"@tiptap/extension-superscript": "^3.29.0",
		"@tiptap/extension-table": "^3.29.0",
		"@tiptap/extension-text-align": "^3.29.0",
		"@tiptap/extension-text-style": "^3.29.0",
		"@tiptap/pm": "^3.29.0",
		"@tiptap/starter-kit": "^3.29.0",
		"pagedjs": "^0.4.3"
	},
	"devDependencies": {
		"compote-ui": "^0.68.2",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@iconify-json/ph": "^1.2.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.22",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.65.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.5"
	},
	"keywords": [
		"svelte"
	]
}
