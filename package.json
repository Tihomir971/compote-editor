{
	"name": "compote-editor",
	"version": "0.6.1",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev --open",
		"build": "bun run sync:pagedjs-polyfill && vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "bun run sync:pagedjs-polyfill && svelte-kit sync || echo ''",
		"prepack": "bun run sync:pagedjs-polyfill && svelte-kit sync && svelte-package && publint",
		"sync:pagedjs-polyfill": "node scripts/sync-pagedjs-polyfill.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"patch": "npm version patch && npm publish",
		"minor": "npm version minor && npm publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"compote-ui": ">=0.68.2",
		"svelte": "^5.55.9"
	},
	"dependencies": {
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-subscript": "^3.33.0",
		"@tiptap/extension-superscript": "^3.33.0",
		"@tiptap/extension-table": "^3.33.0",
		"@tiptap/extension-text-align": "^3.33.0",
		"@tiptap/extension-text-style": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"pagedjs": "^0.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/ph": "^1.2.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"compote-ui": "^0.89.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.6"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
